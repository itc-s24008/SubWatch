{
  "name": "subwatch",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:emulator": "firebase emulators:exec --config ../firebase.json --project demo-subwatch --only auth,firestore \"vitest run --config vitest.emulator.config.ts\"",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "firebase-admin": "^13.10.0",
    "next": "^15.5.29",
    "react": "^19.1.10",
    "react-dom": "^19.1.10",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "~1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.1.0",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
