# 公開用の値の見本（項目の一覧）。ローカルの開発には不要（`.env.development.local` のダミーで動く）。
# 本物の値は ~/secrets/ の中だけに置き、リポジトリの中（subwatch/.env.local を含む）には置かない。subwatch/.env.local は作らない。
# 創大が手で Cron を動かすときだけ、必要な項目を ~/secrets/cron.env に書き（chmod 600）、subwatch/ で node --env-file=$HOME/secrets/cron.env scripts/trigger-cron.mjs として読む（手順書 03 の 6）。
# Vercel に入れる値の控えにしない。GitHub に上げない。AIにも貼らない。
# --- Firebase（ブラウザ用。Firebaseコンソール > プロジェクトの設定 > 全般 > マイアプリ（ウェブ）の値）
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# --- Firebase Admin（サーバー用・秘密）。サービスアカウントキーのJSONをBase64にした1行の文字列
FIREBASE_SERVICE_ACCOUNT_JSON=
# --- Web Push（04-12 で作る。npx --yes web-push@3.6 generate-vapid-keys --json。手順書 03 の 6。VAPID_SUBJECT は、本番ではリーダー〔結愛〕の学校のメールアドレスを mailto: で書く）
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# --- Cron（04-14 で作る）。長いランダム文字列
CRON_SECRET=
# --- 規約の版。公開中は 2026-11-25（変えたら再デプロイ）。テスト（vitest の2本と Playwright）は、.env.development.example をコピーした subwatch/.env.development.local（2026-11-04）を読む
NEXT_PUBLIC_TERMS_VERSION=2026-11-25
NEXT_PUBLIC_PRIVACY_VERSION=2026-11-25
# --- テスト用（本番には設定しない）
# ALLOW_CRON_RUNDATE_OVERRIDE=true
# SUBSCRIPTION_LIMIT_OVERRIDE=
# NEXT_PUBLIC_USE_AUTH_EMULATOR=true
