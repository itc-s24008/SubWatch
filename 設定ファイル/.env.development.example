# ダミー値のみ（Emulator 専用。実プロジェクトの値は入れない）
NEXT_PUBLIC_FIREBASE_API_KEY=dummy
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-subwatch.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-subwatch
NEXT_PUBLIC_FIREBASE_APP_ID=dummy
NEXT_PUBLIC_TERMS_VERSION=2026-11-04
NEXT_PUBLIC_PRIVACY_VERSION=2026-11-04
NEXT_PUBLIC_USE_AUTH_EMULATOR=true
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Cron と Push 用（04-12・04-14・04-15。ローカル用のダミー値。web-push generate-vapid-keys で生成）
# ここの CRON_SECRET と VAPID の鍵は、本番（Vercel）では使わない。本番の値は、手順書のとおりに作り直す。
CRON_SECRET=dummy-cron-secret-for-emulator-only
ALLOW_CRON_RUNDATE_OVERRIDE=true
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BLZ9hO4SdGCHikKVeL988TFz1fot8Efg9njW4Fxeg2LRVeFsH1up_XYpS3DzouyOq_nMTfcreaUddqrj4KACga4
VAPID_PRIVATE_KEY=OUUnNljmclSOeH2qhWkSpxn7tWEKal1Lk3G7yJYh3wI
VAPID_SUBJECT=mailto:dev@example.com

# 空にして、本物の値を使わせない（本物の値は ~/secrets/ の中だけに置く。subwatch/.env.local は作らない）
FIREBASE_SERVICE_ACCOUNT_JSON=

# 手で仮データを試すとき（テストのときは消す）
# NEXT_PUBLIC_USE_MOCKS=true
